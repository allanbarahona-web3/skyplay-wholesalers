# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Servidor
NODE_ENV=development
SESSION_COOKIE_NAME=sky_sid
PORT=3000

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Frontend
FRONTEND_URL=http://localhost:3001

# SMTP Configuration (Email)
# Para Gmail:
# - Usar una "App Password" (no tu contraseña normal)
# - Habilitar "2-Step Verification" en tu cuenta de Google
# - Ir a: https://myaccount.google.com/apppasswords
# - Generar una contraseña de aplicación y usarla en SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui

# SINPE Configuration (Costa Rica)
SINPE_PHONE=8888-8888
SINPE_ACCOUNT_NAME=Skyplay Costa Rica

# PayPal Configuration
# Obtener en: https://developer.paypal.com/dashboard/
# Para producción cambiar PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
